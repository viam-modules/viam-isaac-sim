{
  "name": "scene_camera-control",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "A custom control for one Viam model, built with Svelte 5 and shipped as one index.html.",
  "scripts": {
    "dev": "vite --open /dev/host.html",
    "build": "vite build",
    "check:artifact": "node scripts/check-artifact.mjs",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "verify": "pnpm run format && pnpm run lint && pnpm run check && pnpm run test && pnpm run build && pnpm run check:artifact"
  },
  "dependencies": {
    "@viamrobotics/post-message-sdk": "^0.3.0",
    "@viamrobotics/prime-core": "^0.1.23",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@ag-grid-community/client-side-row-model": "^32.3.9",
    "@ag-grid-community/core": "^32.3.9",
    "@ag-grid-community/styles": "^32.3.9",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.6.4",
    "@viamrobotics/sdk": "^0.76.0",
    "@viamrobotics/tailwind-config": "^1.3.0",
    "@zag-js/dialog": "1.40.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
