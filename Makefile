UI := scene_camera_ui/dist/index.html

module.tar.gz: run.sh first_run.sh pyproject.toml uv.lock meta.json .python-version env.sh $(UI) $(shell find src -name '*.py')
	tar czf $@ --exclude='__pycache__' --exclude='*.pyc' $^

# explicit rule: % would not expand inside $(shell find ...)
$(UI): $(shell find scene_camera_ui/src -type f) scene_camera_ui/index.html scene_camera_ui/package.json scene_camera_ui/pnpm-lock.yaml $(wildcard scene_camera_ui/*.config.* scene_camera_ui/tsconfig*.json)
	cd scene_camera_ui && pnpm install --frozen-lockfile && pnpm build

# The entrypoint (run.sh) is generated by the build on purpose: viam's
# cloud reload treats a module whose entrypoint already exists in the repo as
# "pre-built" and skips packaging entirely.
run.sh: run.nodetect.sh
	cp run.nodetect.sh run.sh

test:
	# `python -m` here is load bearing for allowing imports to work
	uv run --with pytest python -m pytest

lint:
	uv run --with ruff ruff check .

clean:
	rm -rf module.tar.gz run.sh scene_camera_ui/dist

sim-config.json: live-config.json
	python3 config_toggler.py set $^ --to sim --mapping lite6-sim-real-mapping.json --fragment 1141b2a7-1b20-4047-8766-12da9524c80f:lite-realsense-wrist-mount.json -o $@

.PHONY: test clean
